<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hares_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HARES  |  حارس"
            android:textColor="?attr/primaryTextColor"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="مركز الحماية الرقمية"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="14sp"
            android:gravity="end" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/cardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="فحص الروابط والتنبيه من مؤشرات التصيد"
                    android:textColor="?attr/primaryTextColor"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ألصق الرابط أو شاركه إلى حارس من واتساب أو المتصفح. الفحص المحلي لا يثبت أن الرابط آمن."
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="13sp"
                    android:gravity="end" />

                <EditText
                    android:id="@+id/hares_link_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="https://example.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textDirection="ltr"
                    android:gravity="start|center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/rectangle_border_background" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/hares_paste_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="لصق الرابط" />

                    <Button
                        android:id="@+id/hares_scan_button"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="افحص الآن" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hares_scan_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="14dp"
                    android:background="@drawable/rectangle_border_background"
                    android:text="نتيجة الفحص ستظهر هنا."
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="?attr/cardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سجل الحوادث"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="end" />

                <TextView
                    android:id="@+id/hares_incident_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="13sp"
                    android:gravity="end" />

                <TextView
                    android:id="@+id/hares_incident_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="13sp"
                    android:gravity="end" />

                <Button
                    android:id="@+id/hares_clear_history_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="مسح السجل" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="محرك الجدار الناري وVPN الأصلي من Rethink مكوّن مستقل عن فحص الروابط. لا تعتبر نتيجة الفحص المحلي ضماناً لحماية الحسابات البنكية."
            android:textColor="?attr/primaryLightColorText"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
